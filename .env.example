# ─── GasControl — Variables de entorno ───────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a GitHub (ya está en .gitignore).

# Tu dominio (DuckDNS, No-IP, etc.)
DOMAIN=tudominio.duckdns.org

# Clave secreta para firmar las sesiones — genera una aleatoria:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# Credenciales de acceso a la app
APP_USER=admin
APP_PASSWORD=cambia_esto_por_una_contrasena_segura
